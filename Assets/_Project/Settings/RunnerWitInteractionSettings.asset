%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d1ef3bfd9e486124081fc6c06a7713a5, type: 3}
  m_Name: RunnerWitInteractionSettings
  m_EditorClassIdentifier: Assembly-CSharp::StreamOn.Minigames.Runner.RunnerWitInteractionSettings
  firstPromptDelay: 14
  minimumPromptInterval: 18
  maximumPromptInterval: 28
  levelOneResponseSeconds: 7
  levelTwoResponseSeconds: 8
  levelThreeResponseSeconds: 9
  minimumViewers: 1
  prompts:
  - viewerMessage: "아까 그거 일부러 맞은 거죠?"
    choices:
    - {text: "방송각을 위한 큰 그림이지", quality: 2, minimumTalkingLevel: 1}
    - {text: "맞은 게 아니라 웃음 포인트를 잡은 거지", quality: 2, minimumTalkingLevel: 1}
    - {text: "아니 진짜 실수였어", quality: 1, minimumTalkingLevel: 1}
    - {text: "내가 알아서 할게, 질문 그만해", quality: 0, minimumTalkingLevel: 1}
  - viewerMessage: "오늘도 엔딩 못 보는 거 아님?"
    choices:
    - {text: "엔딩이 나를 아직 못 본 거지", quality: 2, minimumTalkingLevel: 1}
    - {text: "엔딩이 자꾸 나를 피해 다니네", quality: 2, minimumTalkingLevel: 1}
    - {text: "오늘은 진짜 가능함", quality: 1, minimumTalkingLevel: 1}
    - {text: "그걸 왜 자꾸 물어봐?", quality: 0, minimumTalkingLevel: 1}
  - viewerMessage: "실력 방송 맞나요?"
    choices:
    - {text: "웃기는 것도 실력입니다", quality: 2, minimumTalkingLevel: 1}
    - {text: "실력보다 입담 티어가 더 높습니다", quality: 2, minimumTalkingLevel: 1}
    - {text: "아직 연습 중인 실력 방송", quality: 1, minimumTalkingLevel: 1}
    - {text: "보기 싫으면 나가세요", quality: 0, minimumTalkingLevel: 1}
  - viewerMessage: "방금 플레이 해명 부탁드립니다"
    choices:
    - {text: "해명은 다음 판의 나에게 맡긴다", quality: 2, minimumTalkingLevel: 1}
    - {text: "해명 대신 다음 판으로 증명합니다", quality: 2, minimumTalkingLevel: 1}
    - {text: "손이 잠깐 미끄러졌어", quality: 1, minimumTalkingLevel: 1}
    - {text: "그 장면 본 사람이 잘못임", quality: 0, minimumTalkingLevel: 1}
  - viewerMessage: "이거 클립 따도 됨?"
    choices:
    - {text: "제목은 전설의 시작으로 부탁", quality: 2, minimumTalkingLevel: 1}
    - {text: "클립 따면 실패 부분은 잘라줘", quality: 2, minimumTalkingLevel: 1}
    - {text: "잘 나온 부분만 따줘", quality: 1, minimumTalkingLevel: 1}
    - {text: "그걸 왜 클립으로 따?", quality: 0, minimumTalkingLevel: 1}
  - viewerMessage: "오늘 왜 이렇게 잘함?"
    choices:
    - {text: "오늘만 잘한다는 전제가 이상한데?", quality: 2, minimumTalkingLevel: 1}
    - {text: "잘하는 날도 있어야 방송이지", quality: 2, minimumTalkingLevel: 1}
    - {text: "오늘 컨디션이 좀 좋네", quality: 1, minimumTalkingLevel: 1}
    - {text: "원래 잘했는데 뭘 본 거야?", quality: 0, minimumTalkingLevel: 1}
  - viewerMessage: "그 실력으로 방송 왜 켰냐 걍 접어"
    choices:
    - {text: "접으라면서 끝까지 보는 건 뭐임 ㅋㅋ", quality: 2, minimumTalkingLevel: 1}
    - {text: "오늘 폐업 심사관 오셨네", quality: 2, minimumTalkingLevel: 1}
    - {text: "조금만 더 해보고 판단해줘", quality: 1, minimumTalkingLevel: 1}
    - {text: "너보단 잘하거든?", quality: 0, minimumTalkingLevel: 1}
  - viewerMessage: "시청자도 없는데 혼자 뭐함?"
    choices:
    - {text: "한 명 생겼네, 어서 와", quality: 2, minimumTalkingLevel: 1}
    - {text: "첫 시청자 발견, 이제 둘이 한다", quality: 2, minimumTalkingLevel: 1}
    - {text: "사람 올 때까지 게임하는 중", quality: 1, minimumTalkingLevel: 1}
    - {text: "시청자 수까지 왜 신경 써?", quality: 0, minimumTalkingLevel: 1}
