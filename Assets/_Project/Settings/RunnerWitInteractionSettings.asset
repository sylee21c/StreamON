%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d1ef3bfd9e486124081fc6c06a7713a5, type: 3}
  m_Name: RunnerWitInteractionSettings
  m_EditorClassIdentifier: Assembly-CSharp::StreamOn.Minigames.Runner.RunnerWitInteractionSettings
  firstPromptDelay: 14
  minimumPromptInterval: 18
  maximumPromptInterval: 28
  levelOneResponseSeconds: 7
  levelTwoResponseSeconds: 8
  levelThreeResponseSeconds: 9
  minimumViewers: 1
  prompts:
  - viewerMessage: "아까 그거 일부러 맞은 거죠?"
    choices:
    - {text: "맞아, 방송각 하나 제대로 챙겼습니다", quality: 2, minimumTalkingLevel: 1}
    - {text: "딜은 내가 받고 웃음은 여러분이 받는 겁니다", quality: 2, minimumTalkingLevel: 1}
    - {text: "아니, 방금은 그냥 실수였어", quality: 1, minimumTalkingLevel: 1}
    - {text: "어... 그게... 손이 갑자기 저기... 미안", quality: 0, minimumTalkingLevel: 1}
  - viewerMessage: "오늘도 엔딩 못 보는 거 아님?"
    choices:
    - {text: "엔딩한테 전해, 오늘은 도망 못 간다고", quality: 2, minimumTalkingLevel: 1}
    - {text: "오늘은 엔딩이 먼저 나를 보게 될 겁니다", quality: 2, minimumTalkingLevel: 1}
    - {text: "오늘은 끝까지 한번 가볼게", quality: 1, minimumTalkingLevel: 1}
    - {text: "어... 엔딩은... 다음 생에 보면 되나? 하하...", quality: 0, minimumTalkingLevel: 1}
  - viewerMessage: "실력 방송 맞나요?"
    choices:
    - {text: "실력도 웃음도 둘 다 챙기는 방송입니다", quality: 2, minimumTalkingLevel: 1}
    - {text: "지금부터 실력 방송으로 장르 변경합니다", quality: 2, minimumTalkingLevel: 1}
    - {text: "아직 연습 중이긴 해", quality: 1, minimumTalkingLevel: 1}
    - {text: "저... 실력이... 어제 세탁기에 들어가서...", quality: 0, minimumTalkingLevel: 1}
  - viewerMessage: "방금 플레이 해명 부탁드립니다"
    choices:
    - {text: "해명 대신 다음 플레이로 증명하겠습니다", quality: 2, minimumTalkingLevel: 1}
    - {text: "방금 장면은 웃음 예고편이었습니다", quality: 2, minimumTalkingLevel: 1}
    - {text: "방금은 판단이 조금 늦었어", quality: 1, minimumTalkingLevel: 1}
    - {text: "어... 제 손이 저한테 말도 없이 움직여서...", quality: 0, minimumTalkingLevel: 1}
  - viewerMessage: "이거 클립 따도 됨?"
    choices:
    - {text: "좋지, 제목은 오늘의 명장면으로 부탁", quality: 2, minimumTalkingLevel: 1}
    - {text: "따줘, 다음 장면이랑 비교하면 더 재밌다", quality: 2, minimumTalkingLevel: 1}
    - {text: "잘 나온 부분이면 괜찮아", quality: 1, minimumTalkingLevel: 1}
    - {text: "어... 클립은... 가위로 따는 건가? 하하...", quality: 0, minimumTalkingLevel: 1}
  - viewerMessage: "오늘 왜 이렇게 잘함?"
    choices:
    - {text: "이제야 평소 실력이 화면에 제대로 잡히네", quality: 2, minimumTalkingLevel: 1}
    - {text: "오늘 폼 좋습니다, 이대로 엔딩까지 갑니다", quality: 2, minimumTalkingLevel: 1}
    - {text: "오늘 컨디션이 좀 좋네", quality: 1, minimumTalkingLevel: 1}
    - {text: "어... 잘하면... 제가 아닌 건가요? 누구지...", quality: 0, minimumTalkingLevel: 1}
  - viewerMessage: "그 실력으로 방송 왜 켰냐 걍 접어"
    choices:
    - {text: "접으라면서 끝까지 봐주는 건 인정이지", quality: 2, minimumTalkingLevel: 1}
    - {text: "폐업 심사는 방송 끝나고 받겠습니다", quality: 2, minimumTalkingLevel: 1}
    - {text: "조금만 더 보고 판단해줘", quality: 1, minimumTalkingLevel: 1}
    - {text: "어... 접으려면... 종이부터 가져와야 하나...", quality: 0, minimumTalkingLevel: 1}
  - viewerMessage: "시청자도 없는데 혼자 뭐함?"
    choices:
    - {text: "한 명 왔네, 어서 와. 이제 방송 시작이다", quality: 2, minimumTalkingLevel: 1}
    - {text: "첫 관객 입장, 지금부터 둘이 재밌게 가자", quality: 2, minimumTalkingLevel: 1}
    - {text: "사람 올 때까지 게임하고 있었어", quality: 1, minimumTalkingLevel: 1}
    - {text: "어... 혼자는 둘이 아니니까... 셋인가? 하하...", quality: 0, minimumTalkingLevel: 1}
