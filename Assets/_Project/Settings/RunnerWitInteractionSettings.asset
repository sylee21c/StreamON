--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d1ef3bfd9e486124081fc6c06a7713a5, type: 3}
  m_Name: RunnerWitInteractionSettings
  m_EditorClassIdentifier: Assembly-CSharp::StreamOn.Minigames.Runner.RunnerWitInteractionSettings
  firstPromptDelay: 14
  minimumPromptInterval: 18
  maximumPromptInterval: 28
  levelOneResponseSeconds: 7
  levelTwoResponseSeconds: 8
  levelThreeResponseSeconds: 9
  minimumViewers: 1
  prompts:
  - viewerMessage: "\uC544\uAE4C \uADF8\uAC70 \uC77C\uBD80\uB7EC \uB9DE\uC740 \uAC70\uC8E0?"
    choices:
    - text: "\uBC29\uC1A1\uAC01\uC744 \uC704\uD55C \uD070 \uADF8\uB9BC\uC774\uC9C0"
      quality: 2
      minimumTalkingLevel: 1
    - text: "\uC544\uB2C8 \uC9C4\uC9DC \uC2E4\uC218\uC600\uC5B4"
      quality: 1
      minimumTalkingLevel: 1
    - text: "다음엔 일부러 피하는 것도 보여줄게"
      quality: 0
      minimumTalkingLevel: 2
  - viewerMessage: "\uC624\uB298\uB3C4 \uC5D4\uB529 \uBABB \uBCF4\uB294 \uAC70 \uC544\uB2D8?"
    choices:
    - text: "\uC5D4\uB529\uC774 \uB098\uB97C \uC544\uC9C1 \uBABB \uBCF8 \uAC70\uC9C0"
      quality: 2
      minimumTalkingLevel: 1
    - text: "\uC624\uB298\uC740 \uC9C4\uC9DC \uAC00\uB2A5\uD568"
      quality: 1
      minimumTalkingLevel: 1
    - text: "못 보면 엔딩이 다음 방송까지 늘어남"
      quality: 0
      minimumTalkingLevel: 2
  - viewerMessage: "\uC2E4\uB825 \uBC29\uC1A1 \uB9DE\uB098\uC694?"
    choices:
    - text: "\uC6C3\uAE30\uB294 \uAC83\uB3C4 \uC2E4\uB825\uC785\uB2C8\uB2E4"
      quality: 2
      minimumTalkingLevel: 1
    - text: "\uC5F0\uC2B5 \uC911\uC778 \uC2E4\uB825 \uBC29\uC1A1"
      quality: 1
      minimumTalkingLevel: 1
    - text: "실력은 채팅이 키우는 중입니다"
      quality: 0
      minimumTalkingLevel: 2
  - viewerMessage: "\uBC29\uAE08 \uD50C\uB808\uC774 \uD574\uBA85 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4"
    choices:
    - text: "\uD574\uBA85\uC740 \uB2E4\uC74C \uD310\uC758 \uB098\uC5D0\uAC8C \uB9E1\uAE34\uB2E4"
      quality: 2
      minimumTalkingLevel: 1
    - text: "\uC190\uC774 \uC7A0\uAE50 \uBBF8\uB044\uB7EC\uC84C\uC5B4"
      quality: 1
      minimumTalkingLevel: 1
    - text: "방금 장면은 편집본에서 사라집니다"
      quality: 0
      minimumTalkingLevel: 2
  - viewerMessage: "\uC774\uAC70 \uD074\uB9BD \uB530\uB3C4 \uB428?"
    choices:
    - text: "\uC81C\uBAA9\uC740 \uC804\uC124\uC758 \uC2DC\uC791\uC73C\uB85C \uBD80\uD0C1"
      quality: 2
      minimumTalkingLevel: 1
    - text: "\uC798 \uB098\uC628 \uBD80\uBD84\uB9CC \uB530\uC918"
      quality: 1
      minimumTalkingLevel: 1
    - text: "제목은 잘한 척하는 법으로 부탁"
      quality: 0
      minimumTalkingLevel: 2
  - viewerMessage: "\uC624\uB298 \uC65C \uC774\uB807\uAC8C \uC798\uD568?"
    choices:
    - text: "\uC624\uB298\uB9CC \uC798\uD55C\uB2E4\uB294 \uC804\uC81C\uAC00 \uC774\uC0C1\uD55C\uB370?"
      quality: 2
      minimumTalkingLevel: 1
    - text: "\uCEE8\uB514\uC158\uC774 \uC880 \uC88B\uB124"
      quality: 1
      minimumTalkingLevel: 1
    - text: "이제야 손이 방송에 도착함"
      quality: 0
      minimumTalkingLevel: 2
  - viewerMessage: "그 실력으로 방송 왜 켰냐 걍 접어"
    ignoreIsCorrect: 1
    choices:
    - text: "그래도 너는 계속 보고 있네"
      quality: 0
      minimumTalkingLevel: 1
    - text: "싫으면 나가도 돼"
      quality: 0
      minimumTalkingLevel: 1
    - text: "네가 해봐"
      quality: 0
      minimumTalkingLevel: 1
  - viewerMessage: "시청자도 없는데 혼자 뭐함?"
    ignoreIsCorrect: 1
    choices:
    - text: "너 있잖아"
      quality: 0
      minimumTalkingLevel: 1
    - text: "게임하고 있지"
      quality: 0
      minimumTalkingLevel: 1
    - text: "조용히 해"
      quality: 0
      minimumTalkingLevel: 1
